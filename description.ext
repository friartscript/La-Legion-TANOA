class RscTitles
{
    class LL_Legion_Subtitles
    {
        idd = -1;
        movingEnable = 0;
        duration = 10000;
        fadein = 0;
        fadeout = 0;
        name = "LL_Legion_Subtitles";
        onLoad = "uiNamespace setVariable ['LL_disp_subtitles', _this select 0];";
        onUnload = "uiNamespace setVariable ['LL_disp_subtitles', displayNull];";
        class controls
        {
            class SubtitleText: RscStructuredText
            {
                idc = 8888;
                x = "safezoneX";
                y = "safezoneY + safezoneH - 0.15";
                w = "safezoneW";
                h = "0.14";
                colorBackground[] = {0, 0, 0, 0};
                size = "(((((safezoneW / safezoneH) min 1.2) / 1.2) / 25) * 1.15)";
                class Attributes
                {
                    font = "PuristaMedium";
                    color = "#ffffff";
                    align = "center";
                    shadow = 2;
                };
            };
        };
    };
};

class CfgDebriefing
{
    class End1
    {
        title = "$STR_LL_Debrief_Win_Title";
        subtitle = "$STR_LL_Debrief_Win_Sub";
